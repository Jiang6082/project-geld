[Unit]
Description=Project Geld Daily V4 close reconciliation (read-only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO@/.venv/bin/geld --config configs/paper-daily-v4.toml --log-json artifacts/logs/daily-v4.jsonl run-close-check --output artifacts/paper-daily-v4 --close-output artifacts/paper-daily-v4-close
TimeoutStartSec=30min
